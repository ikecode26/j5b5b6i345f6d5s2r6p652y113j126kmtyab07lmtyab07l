<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>思知 AI 聊天</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background: #f0f2f5;
    height: 100vh;
    display: flex;
    overflow: hidden;
  }

  /* 侧边栏 — 对话列表 */
  .sidebar {
    width: 260px;
    background: #1e1e2e;
    color: #cdd6f4;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }
  .sidebar-header {
    padding: 16px;
    border-bottom: 1px solid #313244;
  }
  .sidebar-header h1 {
    font-size: 16px;
    font-weight: 600;
    color: #cba6f7;
    margin-bottom: 12px;
  }
  .new-chat-btn {
    width: 100%;
    padding: 10px;
    background: #cba6f7;
    color: #1e1e2e;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .new-chat-btn:hover { background: #b4befe; }
  .chat-list {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
  }
  .chat-item {
    padding: 10px 12px;
    border-radius: 8px;
    cursor: pointer;
    margin-bottom: 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.15s;
    font-size: 13px;
  }
  .chat-item:hover { background: #313244; }
  .chat-item.active { background: #45475a; }
  .chat-item .title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }
  .chat-item .del-btn {
    background: none;
    border: none;
    color: #f38ba8;
    cursor: pointer;
    font-size: 16px;
    padding: 0 4px;
    opacity: 0;
    transition: opacity 0.15s;
    line-height: 1;
  }
  .chat-item:hover .del-btn { opacity: 1; }

  /* 主聊天区 */
  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #fff;
    min-width: 0;
  }
  .chat-header {
    padding: 14px 20px;
    border-bottom: 1px solid #e5e7eb;
    background: #fafafa;
    font-size: 15px;
    font-weight: 600;
    color: #1e1e2e;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .chat-header .dot {
    width: 8px; height: 8px; border-radius: 50%; background: #a6e3a1;
  }

  .messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: #f7f7f8;
  }
  .msg {
    max-width: 78%;
    padding: 12px 16px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.6;
    word-break: break-word;
    white-space: pre-wrap;
    animation: fadeIn 0.25s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .msg.user {
    align-self: flex-end;
    background: #cba6f7;
    color: #1e1e2e;
    border-bottom-right-radius: 4px;
  }
  .msg.ai {
    align-self: flex-start;
    background: #fff;
    color: #1e1e2e;
    border: 1px solid #e5e7eb;
    border-bottom-left-radius: 4px;
  }
  .msg.ai.streaming::after {
    content: "▊";
    animation: blink 0.8s infinite;
    color: #cba6f7;
  }
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .empty-hint {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #9ca3af;
    font-size: 14px;
    gap: 8px;
  }
  .empty-hint span { font-size: 36px; }

  .input-bar {
    padding: 14px 20px;
    border-top: 1px solid #e5e7eb;
    background: #fff;
    display: flex;
    gap: 10px;
    align-items: flex-end;
  }
  .input-bar textarea {
    flex: 1;
    resize: none;
    border: 1px solid #d1d5db;
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 14px;
    font-family: inherit;
    line-height: 1.5;
    max-height: 120px;
    min-height: 42px;
    outline: none;
    transition: border 0.2s;
  }
  .input-bar textarea:focus { border-color: #cba6f7; }
  .send-btn {
    width: 42px; height: 42px;
    border-radius: 50%;
    border: none;
    background: #cba6f7;
    color: #1e1e2e;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.1s;
    flex-shrink: 0;
  }
  .send-btn:hover { background: #b4befe; }
  .send-btn:active { transform: scale(0.94); }
  .send-btn:disabled { background: #e5e7eb; cursor: not-allowed; }

  /* 滚动条美化 */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
  .sidebar ::-webkit-scrollbar-thumb { background: #45475a; }

  /* 移动端适配 */
  @media (max-width: 700px) {
    .sidebar {
      width: 100%;
      position: absolute;
      z-index: 10;
      height: 100vh;
      transform: translateX(-100%);
      transition: transform 0.25s;
    }
    .sidebar.open { transform: translateX(0); }
    .sidebar-toggle {
      display: flex !important;
    }
  }
  .sidebar-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: #1e1e2e;
    padding: 0 4px;
  }
</style>
</head>
<body>

<!-- ========== 侧边栏 ========== -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <h1>💬 思知 AI</h1>
    <button class="new-chat-btn" onclick="createNewChat()">＋ 新建对话</button>
  </div>
  <div class="chat-list" id="chatList"></div>
</aside>

<!-- ========== 主区域 ========== -->
<div class="main">
  <div class="chat-header">
    <button class="sidebar-toggle" onclick="document.getElementById('sidebar').classList.toggle('open')">☰</button>
    <span class="dot"></span>
    <span id="chatTitle">新对话</span>
  </div>

  <div class="messages" id="messages">
    <div class="empty-hint">
      <span>🤖</span>
      开始你的第一句话吧
    </div>
  </div>

  <div class="input-bar">
    <textarea id="input" rows="1" placeholder="输入消息…（Enter 发送，Shift+Enter 换行）"></textarea>
    <button class="send-btn" id="sendBtn" onclick="sendMessage()">➤</button>
  </div>
</div>

<script>
/* ============================================================
   配置
   ============================================================ */
const APPID = "4fc72786fc9e484e9971180b5b05bd3e";
const API_URL = "https://api.sizhi.com/chat";
const STORAGE_KEY = "sizhi_chats_v1";

/* ============================================================
   状态
   ============================================================ */
let chats = [];          // [{ id, title, messages: [{role, content}] }]
let currentChatId = null;
let isStreaming = false;
let abortController = null;

/* ============================================================
   本地存储
   ============================================================ */
function loadChats() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      chats = JSON.parse(raw);
      // 确保每条对话都有 messages 数组
      chats.forEach(c => { if (!c.messages) c.messages = []; });
    }
  } catch (e) {
    console.warn("读取本地数据失败", e);
    chats = [];
  }
  if (!chats.length) {
    createNewChat(false);
  } else {
    currentChatId = chats[0].id;
  }
}

function saveChats() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(chats));
  } catch (e) {
    console.warn("保存本地数据失败", e);
  }
}

/* ============================================================
   对话管理
   ============================================================ */
function createNewChat(render = true) {
  const chat = {
    id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
    title: "新对话",
    messages: [],
    createdAt: Date.now()
  };
  chats.unshift(chat);
  currentChatId = chat.id;
  saveChats();
  if (render) {
    renderChatList();
    renderMessages();
    updateTitle();
    document.getElementById("input").focus();
  }
  return chat;
}

function switchChat(id) {
  if (isStreaming) return; // 流式输出中不允许切换
  currentChatId = id;
  renderChatList();
  renderMessages();
  updateTitle();
  // 移动端自动收起侧边栏
  document.getElementById("sidebar").classList.remove("open");
}

function deleteChat(id, e) {
  e.stopPropagation();
  if (isStreaming) return;
  if (!confirm("确定删除这个对话吗？")) return;
  chats = chats.filter(c => c.id !== id);
  if (!chats.length) {
    createNewChat();
  } else {
    if (currentChatId === id) {
      currentChatId = chats[0].id;
    }
    saveChats();
    renderChatList();
    renderMessages();
    updateTitle();
  }
}

function getCurrentChat() {
  return chats.find(c => c.id === currentChatId) || null;
}

/* ============================================================
   渲染
   ============================================================ */
function renderChatList() {
  const list = document.getElementById("chatList");
  list.innerHTML = "";
  chats.forEach(chat => {
    const div = document.createElement("div");
    div.className = "chat-item" + (chat.id === currentChatId ? " active" : "");
    div.onclick = () => switchChat(chat.id);
    div.innerHTML = `
      <span class="title">${escapeHtml(chat.title || "新对话")}</span>
      <button class="del-btn" onclick="deleteChat('${chat.id}', event)" title="删除">×</button>
    `;
    list.appendChild(div);
  });
}

function renderMessages() {
  const container = document.getElementById("messages");
  const chat = getCurrentChat();
  if (!chat || !chat.messages.length) {
    container.innerHTML = `
      <div class="empty-hint">
        <span>🤖</span>
        开始你的第一句话吧
      </div>`;
    return;
  }
  container.innerHTML = "";
  chat.messages.forEach(msg => {
    appendMessageDOM(msg.role, msg.content, false);
  });
  scrollToBottom();
}

function appendMessageDOM(role, content, animate = true) {
  const container = document.getElementById("messages");
  // 移除空状态
  const empty = container.querySelector(".empty-hint");
  if (empty) empty.remove();

  const div = document.createElement("div");
  div.className = `msg ${role === "user" ? "user" : "ai"}`;
  if (!animate) div.style.animation = "none";
  div.textContent = content;
  container.appendChild(div);
  if (animate) scrollToBottom();
  return div;
}

function scrollToBottom() {
  const container = document.getElementById("messages");
  container.scrollTop = container.scrollHeight;
}

function updateTitle() {
  const chat = getCurrentChat();
  document.getElementById("chatTitle").textContent = chat ? chat.title : "新对话";
  document.title = (chat ? chat.title : "新对话") + " - 思知 AI";
}

/* ============================================================
   发送消息 & 流式输出
   ============================================================ */
async function sendMessage() {
  if (isStreaming) return;

  const input = document.getElementById("input");
  const text = input.value.trim();
  if (!text) return;

  const chat = getCurrentChat();
  if (!chat) return;

  // 添加用户消息
  chat.messages.push({ role: "user", content: text });
  appendMessageDOM("user", text);

  // 更新标题（取第一条用户消息前 20 个字符）
  if (chat.title === "新对话" && chat.messages.filter(m => m.role === "user").length === 1) {
    chat.title = text.slice(0, 20) + (text.length > 20 ? "…" : "");
    renderChatList();
    updateTitle();
  }
  saveChats();

  input.value = "";
  input.style.height = "auto";
  setStreaming(true);

  // 创建 AI 消息占位
  const aiDiv = appendMessageDOM("ai", "", true);
  aiDiv.classList.add("streaming");

  // 准备请求参数
  const params = new URLSearchParams({
    appid: APPID,
    spoken: text,
    userid: chat.id,       // 用对话 ID 作为 userid，实现每个对话独立记忆
    stream: "true",
    memory: "true"          // 启用记忆功能
  });

  const url = `${API_URL}?${params.toString()}`;

  // 流式请求
  try {
    abortController = new AbortController();
    const response = await fetch(url, {
      method: "GET",
      signal: abortController.signal
    });

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }

    const reader = response.body.getReader();
    const decoder = new TextDecoder("utf-8");
    let buffer = "";
    let fullText = "";

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;

      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split("\n");
      // 保留最后一行（可能不完整）
      buffer = lines.pop() || "";

      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed) continue;

        // 流式返回格式：data: {...}
        if (trimmed.startsWith("data:")) {
          const jsonStr = trimmed.slice(5).trim();
          if (!jsonStr) continue;
          try {
            const obj = JSON.parse(jsonStr);
            // 兼容两种返回结构
            let chunk = "";
            if (obj.data && obj.data.info && obj.data.info.text) {
              chunk = obj.data.info.text;
            } else if (obj.data && typeof obj.data.text === "string") {
              chunk = obj.data.text;
            }
            if (chunk) {
              fullText += chunk;
              aiDiv.textContent = fullText;
              scrollToBottom();
            }
          } catch (e) {
            // 忽略解析失败的行
          }
        }
      }
    }

    // 处理 buffer 中剩余的内容
    if (buffer.trim().startsWith("data:")) {
      try {
        const jsonStr = buffer.trim().slice(5).trim();
        if (jsonStr) {
          const obj = JSON.parse(jsonStr);
          let chunk = "";
          if (obj.data && obj.data.info && obj.data.info.text) {
            chunk = obj.data.info.text;
          } else if (obj.data && typeof obj.data.text === "string") {
            chunk = obj.data.text;
          }
          if (chunk) {
            fullText += chunk;
            aiDiv.textContent = fullText;
          }
        }
      } catch (e) { /* ignore */ }
    }

    // 保存 AI 回复
    if (fullText) {
      chat.messages.push({ role: "assistant", content: fullText });
    } else {
      // 空回复兜底
      aiDiv.textContent = "（未收到回复）";
    }

  } catch (err) {
    if (err.name === "AbortError") {
      aiDiv.textContent = (aiDiv.textContent || "") + "\n[已停止]";
    } else {
      console.error("请求失败:", err);
      aiDiv.textContent = "请求失败：" + err.message;
    }
  } finally {
    aiDiv.classList.remove("streaming");
    setStreaming(false);
    saveChats();
    renderChatList(); // 刷新标题
    abortController = null;
  }
}

function setStreaming(val) {
  isStreaming = val;
  const btn = document.getElementById("sendBtn");
  btn.disabled = val;
  btn.textContent = val ? "⏹" : "➤";
  if (val) {
    btn.onclick = stopStreaming;
  } else {
    btn.onclick = sendMessage;
  }
}

function stopStreaming() {
  if (abortController) {
    abortController.abort();
  }
}

/* ============================================================
   工具函数
   ============================================================ */
function escapeHtml(str) {
  if (!str) return "";
  return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

/* ============================================================
   事件绑定
   ============================================================ */
const inputEl = document.getElementById("input");

inputEl.addEventListener("keydown", (e) => {
  if (e.key === "Enter" && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
});

inputEl.addEventListener("input", () => {
  inputEl.style.height = "auto";
  inputEl.style.height = Math.min(inputEl.scrollHeight, 120) + "px";
});

/* ============================================================
   启动
   ============================================================ */
loadChats();
renderChatList();
renderMessages();
updateTitle();
inputEl.focus();
</script>
</body>
</html>